# LLM Provider 配置
CLAW_PROVIDER=anthropic
CLAW_MODEL=claude-sonnet-4-6
CLAW_API_KEY=your_api_key_here

# 可选：自定义 API 地址（用于本地模型）
# CLAW_BASE_URL=http://localhost:11434/v1

# Agent 行为配置
CLAW_MAX_ITERATIONS=50
CLAW_TEMPERATURE=0.7

# 安全设置
CLAW_DRY_RUN=false
CLAW_CONFIRM_DESTRUCTIVE=true

# 会话和日志
CLAW_SESSION_DIR=~/.claw/sessions
CLAW_LOG_DIR=~/.claw/logs
CLAW_LOG_LEVEL=info

# 功能开关
CLAW_STREAM_RESPONSE=true
CLAW_SAVE_SESSION=true